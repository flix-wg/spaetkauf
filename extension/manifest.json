{
  "manifest_version": 3,
  "name": "Spätkauf for bahn.de",
  "version": "0.1.0",
  "description": "Historical late-train odds and Kurt’s pick alongside your connection results.",
  "permissions": ["storage"],
  "host_permissions": ["https://65-108-33-75.sslip.io/*", "http://127.0.0.1/*", "http://localhost/*"],
  "optional_host_permissions": ["https://*/*"],
  "background": {"service_worker": "src/sw.js"},
  "action": {"default_popup": "src/popup.html", "default_icon": {"16": "icons/16.png", "32": "icons/32.png"}},
  "options_page": "src/options.html",
  "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"},
  "content_scripts": [{"matches": ["https://www.bahn.de/*", "https://int.bahn.de/*"], "js": ["src/parse.js", "src/skeleton.js", "src/overlay.js", "src/content.js"], "run_at": "document_idle"}]
}
